{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hark:dataset:sample:0.1.0",
  "title": "hark dataset sample",
  "description": "One recorded dictation: audio refs, recording metadata, target app/profile, context snapshot at key-down, the shortlist the live client used, system outputs, gold labels and the user's observed correction. Source of truth is one JSON file per sample (samples/YYYY/MM/<sample_id>.json); manifests are compiled from these. Character offsets are Unicode code-point offsets, half-open [start, end). Large or sensitive texts are content-addressed blobs (see $defs/text_blob). Context variants and offline runs live in separate files and reuse $defs/context_snapshot, $defs/shortlist, $defs/variant and $defs/system_output. See docs/dataset/spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "session_id",
    "created_at",
    "collection",
    "privacy",
    "speaker",
    "audio",
    "recording",
    "target",
    "context",
    "shortlist_used",
    "gold"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "sample_id": { "$ref": "#/$defs/sample_id" },
    "parent_id": {
      "description": "Set when this is a re-recording of the same seed text (e.g. another mic). Bootstrap clusters and split assignment follow the parent.",
      "anyOf": [{ "$ref": "#/$defs/sample_id" }, { "type": "null" }]
    },
    "session_id": {
      "description": "Dictation session = contiguous work block (same agent session, or gap < 30 min). Unit of paired bootstrap resampling.",
      "type": "string",
      "pattern": "^ds_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": { "type": "string", "format": "date-time", "description": "Key-down wall-clock time (UTC)." },
    "dataset_version_added": { "type": "string", "description": "Release in which the sample first appeared, e.g. '0.1.0'." },

    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "protocol_version", "selection"],
      "properties": {
        "mode": { "enum": ["read_seed", "spontaneous", "scripted_entity", "tts_synthetic"] },
        "protocol_version": { "type": "string" },
        "dataset_mode": { "type": "boolean", "description": "True if hark's dataset mode was on (all dictations retained before triage)." },
        "seed": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "seed_text", "reading_style", "seed_in_context_check"],
              "properties": {
                "source": { "enum": ["pi_session", "claude_code_session", "codex_session", "script_template", "manual"] },
                "session_file_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
                "session_entry_id": { "type": ["string", "null"] },
                "seed_timestamp": { "type": ["string", "null"], "format": "date-time" },
                "seed_text": { "$ref": "#/$defs/text_blob" },
                "template_id": { "type": ["string", "null"] },
                "reading_style": { "enum": ["verbatim", "natural_paraphrase"] },
                "teleprompter": { "type": "string", "description": "Where the seed was displayed; must not be inside captured context (e.g. 'phone', 'second_host')." },
                "seed_in_context_check": { "enum": ["clean", "contaminated", "not_checked"] }
              }
            }
          ]
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "inclusion_prob"],
          "properties": {
            "reason": { "enum": ["all", "random", "low_confidence", "user_corrected", "entity_dense", "targeted", "seed_stratified"] },
            "inclusion_prob": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "For importance-weighting non-random selections." }
          }
        }
      }
    },

    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "consent", "scrub", "audio_contains_secret"],
      "properties": {
        "tier": { "enum": ["private_raw", "private_scrubbed", "public_candidate", "public"] },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_consent", "public_release_ok", "voice_release_ok", "third_party_content"],
          "properties": {
            "owner_consent": { "type": "boolean" },
            "public_release_ok": { "type": "boolean" },
            "voice_release_ok": { "type": "boolean", "description": "Voice is biometric; separate from text release." },
            "third_party_content": { "enum": ["none", "possible", "present"] },
            "consent_record": { "type": ["string", "null"], "description": "Path to signed consent for non-owner speakers." }
          }
        },
        "scrub": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "exact_secret_hits", "detector_findings", "llm_review"],
          "properties": {
            "version": { "type": "string" },
            "exact_secret_hits": { "type": "integer", "minimum": 0 },
            "detector": { "type": "string", "description": "e.g. 'trufflehog 3.x' [U]" },
            "detector_findings": { "type": "integer", "minimum": 0, "description": "Findings on scrubbed output; any > 0 blocks leaving private_raw." },
            "deny_pattern_hits": { "type": "integer", "minimum": 0 },
            "llm_review": { "enum": ["pass", "fail", "manual", "not_run"] },
            "screenshot_redaction": { "enum": ["none_captured", "auto", "auto_reviewed", "manual"] },
            "blocked_reason": { "type": ["string", "null"] }
          }
        },
        "audio_contains_secret": { "type": "boolean", "description": "User dictated a secret; audio can never leave private_raw." },
        "delete_raw_after": { "type": ["string", "null"], "format": "date" }
      }
    },

    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker_id", "synthetic"],
      "properties": {
        "speaker_id": { "type": "string", "pattern": "^spk_[a-z0-9_]+$" },
        "synthetic": { "type": "boolean" },
        "synthesis": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["engine", "engine_version", "voice_id", "text_source", "seed"],
              "properties": {
                "engine": { "type": "string" },
                "engine_version": { "type": "string" },
                "voice_id": { "type": "string" },
                "voice_clone_of": { "type": ["string", "null"], "description": "speaker_id when cloned; owner clone is private-only." },
                "reference_audio_sample_ids": { "type": "array", "items": { "$ref": "#/$defs/sample_id" } },
                "text_source": { "enum": ["pi_session_prompt", "repo_template", "llm_generated", "entity_template"] },
                "spoken_form_input": { "type": "boolean", "description": "TTS received spoken form ('use effect'), not canonical ('useEffect')." },
                "seed": { "type": "integer" },
                "pronunciation_check": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "method": { "type": "string" },
                    "per": { "type": "number", "minimum": 0 },
                    "passed": { "type": "boolean" }
                  }
                }
              }
            }
          ]
        },
        "accent": { "type": ["string", "null"] },
        "l1": { "type": ["string", "null"] },
        "condition": { "type": ["string", "null"], "description": "Free text: tired, cold, eating, whispering..." }
      }
    },

    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "asr_16k", "key_up_s"],
      "properties": {
        "original": { "$ref": "#/$defs/audio_file", "description": "Device-native capture, lossless (FLAC) unless the device delivered compressed audio." },
        "asr_16k": { "$ref": "#/$defs/audio_file", "description": "Exactly the 16 kHz mono s16 signal streamed to ASR (after any client DSP), FLAC." },
        "client_dsp": { "type": "array", "items": { "type": "string" }, "description": "Processing applied before asr_16k, e.g. ['downmix_mean', 'soxr_vhq']. Empty = none." },
        "key_down_s": { "type": "number", "const": 0 },
        "key_up_s": { "type": "number", "minimum": 0, "description": "Seconds from key-down (= audio t0) to key-up." },
        "speech": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_s": { "type": "number", "minimum": 0 },
            "end_s": { "type": "number", "minimum": 0 },
            "vad_model": { "type": "string" }
          }
        },
        "stream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chunk_ms": { "type": "integer", "minimum": 1 },
            "chunk_log": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }], "description": "Per-chunk send timestamps for faithful streaming replay." }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "snr_db": { "type": ["number", "null"] },
            "speech_rms_dbfs": { "type": ["number", "null"] },
            "noise_rms_dbfs": { "type": ["number", "null"] },
            "loudness_lufs": { "type": ["number", "null"] },
            "clipping_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        }
      }
    },

    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "mic", "environment", "client"],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_id", "os"],
          "properties": {
            "host_id": { "type": "string", "pattern": "^host_[a-z0-9_]+$" },
            "os": { "enum": ["linux", "macos"] },
            "os_version": { "type": "string" },
            "desktop": { "type": ["string", "null"], "description": "e.g. hyprland, gnome, aqua" },
            "display_server": { "enum": ["wayland", "x11", "quartz", "other"] },
            "audio_stack": { "enum": ["pipewire", "pulseaudio", "alsa", "coreaudio", "other"] }
          }
        },
        "mic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mic_id", "kind"],
          "properties": {
            "mic_id": { "type": "string", "pattern": "^mic_[a-z0-9_]+$" },
            "name": { "type": "string" },
            "kind": { "enum": ["builtin", "usb", "headset_wired", "headset_bt", "array", "other"] },
            "bt_profile": { "type": ["string", "null"], "description": "e.g. hfp_msbc, hfp_cvsd, lc3" },
            "gain_db": { "type": ["number", "null"] }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["noise"],
          "properties": {
            "noise": { "enum": ["quiet", "hum_fan", "keyboard", "office", "cafe", "outdoor", "music", "background_speech"] },
            "noise_level_dba": { "type": ["number", "null"] },
            "distance": { "enum": ["near", "arm", "far", "unknown"] },
            "room": { "type": ["string", "null"] },
            "notes": { "type": ["string", "null"] }
          }
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": { "type": "string" },
            "git_commit": { "type": ["string", "null"] },
            "config_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
          }
        }
      }
    },

    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_id", "app_class", "profile", "input_kind"],
      "properties": {
        "app_id": { "type": "string", "description": "Wayland app_id / X11 WM_CLASS / macOS bundle id." },
        "app_class": { "enum": ["terminal", "browser", "editor_ide", "chat", "email", "notes", "office", "other"] },
        "profile": { "enum": ["agent_prompt", "shell_command", "code_comment", "commit_message", "chat", "email", "doc", "search", "other"] },
        "agent": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "detected_by"],
              "properties": {
                "name": { "type": "string", "description": "pi, claude-code, codex, aider, ..." },
                "version": { "type": ["string", "null"] },
                "detected_by": { "enum": ["process_tree", "window_title", "session_file", "manual"] }
              }
            }
          ]
        },
        "input_kind": { "enum": ["tui_prompt", "shell_prompt", "text_field", "rich_text", "code_editor", "unknown"] },
        "paste_method": { "type": ["string", "null"], "description": "e.g. wtype, ydotool, clipboard+ctrl_v, ax_insert" }
      }
    },

    "context": { "$ref": "#/$defs/context_snapshot" },

    "shortlist_used": {
      "description": "Exactly what the live client sent at capture time (null if hark was not running a contextual provider). Offline variants recompute their own shortlist.",
      "anyOf": [{ "$ref": "#/$defs/shortlist" }, { "type": "null" }]
    },

    "outputs": {
      "description": "Live outputs produced at capture time. Offline runs are stored in runs/<run_group>/outputs.jsonl with the same item schema.",
      "type": "array",
      "items": { "$ref": "#/$defs/system_output" }
    },

    "gold": { "$ref": "#/$defs/gold" },

    "user_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "source"],
      "properties": {
        "observed": { "type": "boolean" },
        "source": { "enum": ["none", "hark_undo", "hark_swap_to_raw", "hark_history_edit", "post_paste_field_diff", "agent_session_submission", "manual_note"] },
        "observed_text": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "delay_ms": { "type": ["integer", "null"], "minimum": 0 },
        "char_edit_distance_from_pasted": { "type": ["integer", "null"], "minimum": 0 },
        "match_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "trusted_as_label": { "type": "boolean", "description": "True only after human confirmation; otherwise silver signal." }
      }
    }
  },

  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "sample_id": { "type": "string", "pattern": "^s_[0-9A-HJKMNP-TV-Z]{26}$" },
    "repo_id": { "type": "string", "pattern": "^r_[0-9a-f]{12}$", "description": "HMAC-SHA256(dataset_key, normalized origin URL or root-commit SHA), first 12 hex." },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "blob_ref": { "type": "string", "pattern": "^blob:(raw|scrubbed):sha256:[0-9a-f]{64}$" },

    "text_blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chars", "truncated"],
      "properties": {
        "raw": { "anyOf": [{ "$ref": "#/$defs/blob_ref" }, { "type": "null" }], "description": "Unscrubbed; private_raw tier only." },
        "scrubbed": { "anyOf": [{ "$ref": "#/$defs/blob_ref" }, { "type": "null" }] },
        "inline": { "type": "string", "maxLength": 512, "description": "Optional scrubbed copy for short texts (titles, seeds)." },
        "chars": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "truncation": { "type": ["string", "null"], "description": "e.g. 'last 200 lines', 'caret±4000 chars'" }
      }
    },

    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },

    "audio_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "codec", "sample_rate", "channels", "duration_s"],
      "properties": {
        "path": { "type": "string", "description": "Relative to dataset root." },
        "sha256": { "$ref": "#/$defs/sha256", "description": "Of the file bytes." },
        "pcm_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }], "description": "Of decoded PCM; stable across re-encodes." },
        "codec": { "enum": ["flac", "wav_pcm", "opus", "msbc", "aac", "other"] },
        "sample_rate": { "type": "integer", "minimum": 8000 },
        "channels": { "type": "integer", "minimum": 1 },
        "sample_format": { "enum": ["s16", "s24", "s32", "f32"] },
        "num_samples": { "type": "integer", "minimum": 0 },
        "duration_s": { "type": "number", "minimum": 0 },
        "derivation": { "type": ["string", "null"], "description": "null for device-native; else recipe, e.g. 'soxr_vhq 48000->16000; downmix mean'." }
      }
    },

    "context_source": {
      "enum": [
        "focused_text", "selection", "window_title", "terminal", "repo_files", "repo_symbols", "git_log",
        "agent_session", "screenshot_ocr", "clipboard", "history", "user_lexicon", "injected_distractor", "none"
      ]
    },

    "context_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "captured_at", "offset_from_keydown_ms", "blocked"],
      "properties": {
        "origin": { "enum": ["live", "live_reenacted", "reconstructed", "variant_generated", "none"] },
        "captured_at": { "type": "string", "format": "date-time" },
        "offset_from_keydown_ms": { "type": "integer", "description": "Negative = captured before key-down (cached)." },
        "capture_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "blocked": {
          "type": "object",
          "additionalProperties": false,
          "required": ["is_blocked"],
          "properties": {
            "is_blocked": { "type": "boolean" },
            "reason": { "enum": [null, "denylisted_app", "password_field", "private_window", "user_paused", "capture_error"] }
          }
        },
        "focused": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app_id": { "type": "string" },
            "app_name": { "type": ["string", "null"] },
            "window_title": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
            "pid_hash": { "type": ["string", "null"] },
            "source": { "enum": ["hyprctl", "sway_ipc", "x11", "atspi", "ax", "other"] }
          }
        },
        "focused_text": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "value"],
              "properties": {
                "source": { "enum": ["atspi", "ax", "terminal_prompt_parse", "other"] },
                "role": { "type": ["string", "null"] },
                "is_password_field": { "type": "boolean" },
                "value": { "$ref": "#/$defs/text_blob" },
                "caret": { "type": ["integer", "null"], "minimum": 0 },
                "selection": {
                  "anyOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["start", "end"],
                      "properties": {
                        "start": { "type": "integer", "minimum": 0 },
                        "end": { "type": "integer", "minimum": 0 },
                        "text": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "terminal": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "visible_text"],
              "properties": {
                "emulator": { "type": ["string", "null"] },
                "multiplexer": { "enum": ["none", "tmux", "zellij", "screen", "other"] },
                "source": { "enum": ["kitty_remote", "wezterm_cli", "tmux_capture_pane", "ghostty", "atspi", "iterm2_api", "ax", "other"] },
                "visible_text": { "$ref": "#/$defs/text_blob" },
                "scrollback_text": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
                "cwd": { "type": ["string", "null"], "description": "Scrubbed: $HOME -> ~." },
                "foreground_process": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "repo": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repo_id", "commit", "file_list_sha256", "symbol_list_sha256"],
              "properties": {
                "repo_id": { "$ref": "#/$defs/repo_id" },
                "is_public_oss": { "type": "boolean" },
                "license_spdx": { "type": ["string", "null"] },
                "commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
                "commit_time": { "type": ["string", "null"], "format": "date-time" },
                "branch": { "type": ["string", "null"] },
                "dirty": { "type": "boolean" },
                "dirty_diff": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
                "file_list": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
                "file_list_sha256": { "$ref": "#/$defs/sha256", "description": "sha256 of sorted, '\\n'-joined repo-relative paths (tracked + untracked-not-ignored)." },
                "n_files": { "type": "integer", "minimum": 0 },
                "symbol_index": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
                "symbol_list_sha256": { "$ref": "#/$defs/sha256", "description": "sha256 of sorted, unique, '\\n'-joined symbol names." },
                "n_symbols": { "type": "integer", "minimum": 0 },
                "indexer": { "type": "string", "description": "e.g. 'universal-ctags 6.1' or 'tree-sitter-tags@<ver>' [U]" },
                "recent_files": { "type": "array", "items": { "type": "string" }, "description": "Recently modified/opened repo-relative paths, most recent first." }
              }
            }
          ]
        },
        "agent_session": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["harness", "match"],
              "properties": {
                "harness": { "enum": ["pi", "claude_code", "codex", "other"] },
                "session_file_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
                "session_id": { "type": ["string", "null"] },
                "last_entry_id": { "type": ["string", "null"], "description": "Last entry included in excerpt (pi entry id)." },
                "match": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["method", "confidence"],
                  "properties": {
                    "method": { "enum": ["cwd_and_mtime", "pid_tty", "window_title", "manual", "none"] },
                    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                    "candidates": { "type": "integer", "minimum": 0 }
                  }
                },
                "excerpt": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
                "excerpt_turns": { "type": "integer", "minimum": 0 },
                "includes_assistant_text": { "type": "boolean" }
              }
            }
          ]
        },
        "screenshot": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "scope", "redaction"],
              "properties": {
                "path": { "type": "string" },
                "sha256": { "$ref": "#/$defs/sha256" },
                "scope": { "enum": ["focused_window", "focused_output", "full"] },
                "redaction": { "enum": ["none", "auto", "auto_reviewed", "manual"] },
                "ocr": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
                "ocr_engine": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "clipboard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opt_in"],
          "properties": {
            "opt_in": { "type": "boolean" },
            "text": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
            "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "chars": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recent_dictations": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }] },
            "n": { "type": "integer", "minimum": 0 }
          }
        },
        "user_lexicon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },

    "shortlist_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term"],
      "properties": {
        "term": { "type": "string", "minLength": 1, "description": "Canonical written form." },
        "aliases": { "type": "array", "items": { "type": "string" }, "description": "Spoken forms." },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/context_source" } },
        "kind": { "type": ["string", "null"] },
        "score": { "type": ["number", "null"] },
        "weight": { "type": ["number", "null"], "description": "Boost actually applied (provider units)." }
      }
    },

    "shortlist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranker_version", "terms"],
      "properties": {
        "ranker_version": { "type": "string" },
        "forced": { "type": "boolean", "description": "True when the list bypasses the ranker (forced-list variants)." },
        "max_terms": { "type": ["integer", "null"], "minimum": 0 },
        "terms": { "type": "array", "items": { "$ref": "#/$defs/shortlist_term" } },
        "free_text_context": { "anyOf": [{ "$ref": "#/$defs/text_blob" }, { "type": "null" }], "description": "Prompt text for providers taking free-text context (e.g. Qwen3-ASR)." },
        "payload_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }], "description": "Hash of the exact provider payload." }
      }
    },

    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w"],
      "properties": {
        "w": { "type": "string" },
        "start_s": { "type": ["number", "null"] },
        "end_s": { "type": ["number", "null"] },
        "conf": { "type": ["number", "null"] }
      }
    },

    "system_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "sample_id", "variant_id", "mode", "system", "final_text", "created_at"],
      "properties": {
        "run_id": { "type": "string" },
        "sample_id": { "$ref": "#/$defs/sample_id" },
        "variant_id": { "type": "string", "description": "'<sample_id>::live' for live outputs." },
        "mode": { "enum": ["live", "replay_stream", "batch"] },
        "repeat_index": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" },
        "system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system_id", "config_sha256"],
          "properties": {
            "system_id": { "type": "string" },
            "config_sha256": { "$ref": "#/$defs/sha256" },
            "client_version": { "type": ["string", "null"] },
            "ranker_version": { "type": ["string", "null"] },
            "canonicalizer_version": { "type": ["string", "null"] },
            "asr": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": { "type": "string" },
                "model": { "type": "string" },
                "revision": { "type": ["string", "null"] },
                "backend": { "type": ["string", "null"] },
                "device": { "type": ["string", "null"], "description": "rtx3060, m5pro, h100, laptop_cpu, cloud" },
                "bias_method": { "enum": ["none", "gpu_pb", "speech_contexts", "free_text_prompt", "keyterms", "context_bias", "other"] },
                "bias_params": { "type": "object" }
              }
            },
            "cleanup": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "provider": { "type": "string" },
                    "model": { "type": "string" },
                    "revision": { "type": ["string", "null"] },
                    "prompt_version": { "type": "string" },
                    "deadline_ms": { "type": ["integer", "null"] }
                  }
                }
              ]
            }
          }
        },
        "shortlist": { "anyOf": [{ "$ref": "#/$defs/shortlist" }, { "type": "null" }] },
        "asr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string" },
            "nbest": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": { "text": { "type": "string" }, "score": { "type": ["number", "null"] } }
              }
            },
            "words": { "type": "array", "items": { "$ref": "#/$defs/word" } },
            "unbiased_text": { "type": ["string", "null"], "description": "No-context anchor decode, if the system ran one." }
          }
        },
        "canonicalized_text": { "type": ["string", "null"] },
        "cleanup": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "edits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["find", "replace", "applied"],
                    "properties": {
                      "find": { "type": "string" },
                      "replace": { "type": "string" },
                      "reason": { "type": ["string", "null"] },
                      "applied": { "type": "boolean" },
                      "rejected_reason": { "type": ["string", "null"], "description": "e.g. protected_span, not_found, ambiguous" }
                    }
                  }
                },
                "timed_out": { "type": "boolean" },
                "text": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "final_text": { "type": "string" },
        "pasted": { "type": ["boolean", "null"] },
        "fallback": { "enum": ["none", "raw_asr", "secondary_provider", "local_cpu", "error"] },
        "guardrail_events": { "type": "array", "items": { "type": "string" } },
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "first_partial": { "type": ["number", "null"] },
            "keyup_to_asr_final": { "type": ["number", "null"] },
            "asr_final_to_cleanup_done": { "type": ["number", "null"] },
            "keyup_to_paste": { "type": ["number", "null"] },
            "audio_duration": { "type": ["number", "null"] },
            "rtf": { "type": ["number", "null"] },
            "network": { "enum": ["lan", "tailscale_remote", "offline_local", "cloud", null] }
          }
        },
        "error": { "type": ["string", "null"] }
      }
    },

    "entity_type": {
      "enum": ["identifier", "path", "flag", "number", "url", "name", "negation", "literal", "term"]
    },

    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "canonical", "spoken", "verbatim_span", "intended_span", "critical"],
      "properties": {
        "id": { "type": "string", "pattern": "^e[0-9]+$" },
        "type": { "$ref": "#/$defs/entity_type" },
        "subtype": {
          "type": ["string", "null"],
          "description": "Open vocabulary; recommended: function, method, class, type, variable, constant, module, package, env_var, branch, commit, command, config_key, file, dir, glob, cli_flag, flag_value, integer, decimal, version, port, line_number, issue_ref, duration, ip, url, domain, email, person, product, org, model, library, not, never, no, spelled, quoted, regex."
        },
        "canonical": { "type": "string", "minLength": 1, "description": "Exact written form; compared byte-exact after NFC." },
        "spoken": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Spoken renderings; [0] = what was actually said in this audio."
        },
        "verbatim_span": { "$ref": "#/$defs/span" },
        "intended_span": {
          "anyOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }],
          "description": "null when the entity does not survive into intended text (e.g. inside a reparandum)."
        },
        "critical": { "type": "boolean", "description": "Wrong value would break the downstream action/meaning." },
        "case_sensitive": { "type": "boolean", "default": true },
        "equivalents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other written forms accepted as exact (e.g. negation \"do not\" for \"don't\"). Keep tiny."
        },
        "role": { "type": ["string", "null"] },
        "grounding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in_repo_index": { "type": ["boolean", "null"] },
            "repo_symbol_kind": { "type": ["string", "null"] },
            "new_symbol": { "type": "boolean", "description": "User names something that does not exist yet." },
            "evidence_sources": { "type": "array", "items": { "$ref": "#/$defs/context_source" } },
            "evidence_tier": {
              "enum": ["E0", "E1", "E2", "E3"],
              "description": "Relative to the captured (correct) context. E1 exact string present; E2 derivable (identifier split, path component, alias); E3 implied only; E0 absent. Adapted from ScreenASR-Bench ETE/EVE/ISE."
            },
            "natural_competitors": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Near-homophone terms already present in the sample's own correct context (reported separately from injected distractors)."
            }
          }
        },
        "vcb_type": { "type": ["string", "null"], "description": "Closest VoiceCodeBench entity type, for cross-reference." }
      }
    },

    "verbatim_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "kind"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["filler", "repetition", "false_start", "reparandum", "repair", "editing_term", "command", "noise", "unintelligible", "foreign"] },
        "ref": { "type": ["string", "null"], "description": "Self-correction id or command id." }
      }
    },

    "protected_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "span", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]+$" },
        "span": { "$ref": "#/$defs/span", "description": "Offsets into gold.intended.text." },
        "kind": { "enum": ["entity", "number", "negation", "quoted", "code", "user_marked"] },
        "entity_id": { "type": ["string", "null"] }
      }
    },

    "self_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "reparandum", "repair"],
      "properties": {
        "id": { "type": "string", "pattern": "^c[0-9]+$" },
        "kind": { "enum": ["replace", "delete", "restart", "spelling_clarification"] },
        "reparandum": { "$ref": "#/$defs/span", "description": "Offsets into gold.verbatim.text." },
        "editing_term": { "anyOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }], "description": "'no wait', 'I mean', 'scratch that'..." },
        "repair": { "anyOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }] }
      }
    },

    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_status", "label_version", "guideline_version", "language", "verbatim", "intended", "entities", "protected_spans", "self_corrections", "flags"],
      "properties": {
        "label_status": { "enum": ["none", "prelabeled", "corrected", "verified", "silver"] },
        "label_version": { "type": "integer", "minimum": 0 },
        "guideline_version": { "type": "string" },
        "labeled_at": { "type": ["string", "null"], "format": "date-time" },
        "prelabel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asr_systems": { "type": "array", "items": { "type": "string" } },
            "llm": { "type": ["string", "null"] },
            "used_context": { "type": "boolean" }
          }
        },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "verbatim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "spans"],
          "properties": {
            "text": { "type": "string", "description": "What was said, incl. disfluencies; entities in spoken form (spoken[0])." },
            "spans": { "type": "array", "items": { "$ref": "#/$defs/verbatim_span" } }
          }
        },
        "verbatim_canonical": {
          "type": ["string", "null"],
          "description": "Derived: verbatim.text with entity spans replaced by canonical. Stored for convenience; validator recomputes."
        },
        "intended": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "description": "What the user wanted pasted: disfluencies removed, self-corrections applied, punctuation/casing/formatting, canonical entities." },
            "alternatives": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Other fully acceptable written forms (rare; e.g. optional trailing period)."
            }
          }
        },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "protected_spans": { "type": "array", "items": { "$ref": "#/$defs/protected_span" } },
        "self_corrections": { "type": "array", "items": { "$ref": "#/$defs/self_correction" } },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["span", "command"],
            "properties": {
              "span": { "$ref": "#/$defs/span" },
              "command": { "type": "string", "description": "new_line, new_paragraph, scratch_that, literal_mode, ..." }
            }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unintelligible", "contains_secret"],
          "properties": {
            "unintelligible": { "type": "boolean" },
            "contains_secret": { "type": "boolean" },
            "truncated_start": { "type": "boolean" },
            "truncated_end": { "type": "boolean" },
            "background_speech": { "type": "boolean" },
            "bias_flag": { "type": "boolean", "description": "Context-seen and blind (audio-only) label passes disagreed on an entity; adjudicated by listening." },
            "exclude_from_eval": { "type": "boolean" },
            "exclude_reason": { "type": ["string", "null"] }
          }
        },
        "notes": { "type": ["string", "null"] }
      }
    },

    "distractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "class", "source"],
      "properties": {
        "term": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "target_entity_id": { "type": ["string", "null"] },
        "target_word": { "type": ["string", "null"], "description": "For distractors aimed at non-entity words." },
        "class": { "enum": ["same_phones", "near_phones", "affix", "common_word", "random_rare"] },
        "phone_distance": { "type": ["number", "null"], "minimum": 0 },
        "source": { "enum": ["other_repo", "public_corpus", "names_list", "generated"] },
        "source_repo_id": { "anyOf": [{ "$ref": "#/$defs/repo_id" }, { "type": "null" }] },
        "injection_sites": { "type": "array", "items": { "$ref": "#/$defs/context_source" } }
      }
    },

    "variant": {
      "description": "One context condition for one sample (variants/<generator_version>/variants.jsonl). Not part of the sample file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "sample_id", "kind", "generator_version", "seed", "context", "shortlist", "gold_in_context"],
      "properties": {
        "variant_id": { "type": "string", "pattern": "^s_[0-9A-HJKMNP-TV-Z]{26}::[a-z_]+(:[A-Za-z0-9_.=,-]+)?::g[0-9]+(\\.[0-9]+)*$" },
        "sample_id": { "$ref": "#/$defs/sample_id" },
        "kind": { "enum": ["correct", "missing", "missing_partial", "stale", "unrelated", "adv_swap", "adv_add", "adv_common", "forced_list"] },
        "params": { "type": "object" },
        "generator_version": { "type": "string" },
        "seed": { "type": "integer" },
        "donor_sample_id": { "anyOf": [{ "$ref": "#/$defs/sample_id" }, { "type": "null" }], "description": "Source of stale/unrelated context." },
        "context": { "$ref": "#/$defs/context_snapshot" },
        "shortlist": { "$ref": "#/$defs/shortlist" },
        "distractors": { "type": "array", "items": { "$ref": "#/$defs/distractor" } },
        "gold_in_context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id", "in_shortlist", "evidence_tier"],
            "properties": {
              "entity_id": { "type": "string" },
              "in_shortlist": { "type": "boolean" },
              "evidence_tier": { "enum": ["E0", "E1", "E2", "E3"] }
            }
          }
        }
      }
    }
  }
}
