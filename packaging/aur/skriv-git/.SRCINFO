pkgbase = skriv-git
	pkgdesc = Context-aware, local-first push-to-talk dictation (daemon, inference server, systemd user units)
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/danth3b0t/skriv
	arch = x86_64
	arch = aarch64
	license = LicenseRef-TODO
	makedepends = git
	makedepends = gobject-introspection
	makedepends = pkgconf
	makedepends = uv
	depends = bash
	depends = cairo
	depends = curl
	depends = libgcc
	depends = libstdc++
	depends = glib2
	depends = gobject-introspection-runtime
	depends = glibc
	depends = libffi
	depends = portaudio
	depends = wl-clipboard
	depends = zlib
	optdepends = gtk4-layer-shell: recording indicator overlay (Hyprland, sway, KDE)
	optdepends = at-spi2-core: caret context through AT-SPI
	optdepends = libnotify: desktop notifications
	optdepends = pipewire: start/stop sounds (pw-play)
	optdepends = wtype: paste fallback outside Hyprland
	optdepends = xclip: paste on X11
	optdepends = xdotool: paste on X11
	optdepends = tmux: caret and screen context from tmux panes
	optdepends = llama-cpp: llama-server for text cleanup (skriv-llama.service)
	optdepends = ggml-cuda: run llama-server on an NVIDIA GPU
	optdepends = ggml-vulkan: run llama-server on other GPUs
	optdepends = openssl: skriv-certs (mTLS certificates for a remote skriv-server)
	optdepends = tailscale: reach a skriv-server on another machine
	provides = skriv
	provides = skriv-server
	conflicts = skriv
	conflicts = skriv-server
	options = !strip
	options = !debug
	source = skriv::git+https://github.com/danth3b0t/skriv.git
	sha256sums = SKIP

pkgname = skriv-git
