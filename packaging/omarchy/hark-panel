#!/bin/bash

# omarchy:summary=Open or close hark's quick panel, with the cursor on the last dictation
#
# Bound to Super Alt D by omarchy-install-dictation-hark: the recovery key the pill names on
# failures (the pill itself is click-through). Talks to the hark.shell bar widget over
# Omarchy's shell IPC; bar widgets take no summon payload, so the widget has its own target.

set -u

notify() {
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send "hark" "$1"
  fi
  echo "hark-panel: $1" >&2
}

if ! command -v omarchy-shell >/dev/null 2>&1; then
  notify "needs Omarchy's shell (omarchy-shell)"
  exit 1
fi

if ! omarchy-shell hark.shell toggleAt last >/dev/null; then
  notify "the hark bar widget is not running; enable it: omarchy plugin enable hark.shell"
  exit 1
fi
