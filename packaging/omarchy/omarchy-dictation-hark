#!/bin/bash

# omarchy:summary=Record dictation using hark
# omarchy:args=<start|stop|toggle>
#
# Omarchy dictation-backend contract (manual, "Dictation"): accept start|stop|toggle, return promptly,
# exit nonzero on failure; `stop` must succeed when hark is idle or not running at all.
# Each action is one `hark ctl` round trip over the daemon's control socket (~50 ms).

set -u

action=${1:-}
case $action in
  start | stop | toggle) ;;
  *)
    echo "Usage: omarchy-dictation-hark <start|stop|toggle>" >&2
    exit 1
    ;;
esac

if ! command -v hark >/dev/null 2>&1; then
  [[ $action == stop ]] && exit 0
  echo "hark is not on PATH (uv tool install --editable ./client from the hark repo)" >&2
  exit 1
fi

reply=$(hark ctl "$action" 2>&1)
status=$?
case $status in
  0) exit 0 ;;
  2) # no daemon listening
    [[ $action == stop ]] && exit 0
    if systemctl --user cat hark.service >/dev/null 2>&1; then
      systemctl --user start --no-block hark.service
      echo "hark was not running; starting hark.service, try again in a moment" >&2
    else
      echo "hark is not running; start it with: hark run" >&2
    fi
    exit 1
    ;;
  *)
    echo "hark: $reply" >&2
    exit 1
    ;;
esac
