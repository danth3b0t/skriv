#!/bin/bash

# omarchy:summary=Record dictation using skriv
# omarchy:args=<start|stop|toggle>
#
# Omarchy dictation-backend contract (manual, "Dictation"): accept start|stop|toggle, return promptly,
# exit nonzero on failure; `stop` must succeed when skriv is idle or not running at all.
# Each action is one `skriv ctl` round trip over the daemon's control socket (~50 ms).

set -u

action=${1:-}
case $action in
  start | stop | toggle) ;;
  *)
    echo "Usage: omarchy-dictation-skriv <start|stop|toggle>" >&2
    exit 1
    ;;
esac

if ! command -v skriv >/dev/null 2>&1; then
  [[ $action == stop ]] && exit 0
  echo "skriv is not on PATH: install the skriv-git package, or uv tool install --editable ./client" >&2
  exit 1
fi

reply=$(skriv ctl "$action" 2>&1)
status=$?
case $status in
  0) exit 0 ;;
  2) # no daemon listening
    [[ $action == stop ]] && exit 0
    if systemctl --user cat skriv.service >/dev/null 2>&1; then
      systemctl --user start --no-block skriv.service
      echo "skriv was not running; starting skriv.service, try again in a moment" >&2
    else
      echo "skriv is not running; start it with: skriv run" >&2
    fi
    exit 1
    ;;
  *)
    echo "skriv: $reply" >&2
    exit 1
    ;;
esac
