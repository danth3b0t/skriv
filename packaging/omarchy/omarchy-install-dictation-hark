#!/bin/bash

# omarchy:summary=Install and configure hark dictation
#
# Installs and starts the hark systemd user unit (`hark service install`), then selects hark as Omarchy's
# dictation backend (omarchy-dictation-use stops the previous backend). From a checkout it also links the
# adapter scripts into ~/.local/bin; the hark-git package puts them in /usr/bin. On Omarchy 4's shell it adds
# hark's bar widget and quick panel (the hark.shell plugin, copied into ~/.config/omarchy/plugins) and binds
# Super Alt D to open the panel (two marked lines in ~/.config/hypr/bindings.lua). Touches nothing else: no
# shell rc files, and Omarchy keeps the dictation keys (Right Alt hold, Alt+Space toggle). Ends with
# `hark doctor`. omarchy-remove-dictation-hark undoes all of it.

set -euo pipefail

if (($# > 0)) && [[ $1 != "--background" ]]; then
  echo "Usage: omarchy-install-dictation-hark [--background]" >&2
  exit 1
fi

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
bind_mark="-- hark: dictation panel (omarchy-remove-dictation-hark removes this line and the next)"
hark=$(command -v hark || true)
if [[ -z $hark ]]; then
  echo "hark is not on PATH: install the hark-git package, or from the hark repo: uv tool install --editable ./client" >&2
  exit 1
fi

if [[ $here != /usr/bin ]]; then # running from a checkout: put the adapter on PATH
  bin="$HOME/.local/bin"
  mkdir -p "$bin"
  for script in omarchy-dictation-hark omarchy-remove-dictation-hark hark-panel; do
    ln -sfn "$here/$script" "$bin/$script"
  done
  plugin_src="$here/hark.shell"
else
  plugin_src=/usr/share/hark/omarchy/hark.shell
fi

"$hark" service install client
omarchy-dictation-use hark

if command -v omarchy-shell >/dev/null 2>&1; then
  # Copies, not links: the shell refuses a plugin folder that holds symlinks. Staged outside the
  # plugins folder (the shell watches it), then swapped in.
  plugin="$config_home/omarchy/plugins/hark.shell"
  staged=$(mktemp -d "${TMPDIR:-/tmp}/hark.shell.XXXXXX")
  cp "$plugin_src/manifest.json" "$plugin_src/Widget.qml" "$plugin_src/Model.js" "$staged/"
  chmod 755 "$staged"
  mkdir -p "${plugin%/*}"
  rm -rf "$plugin"
  mv "$staged" "$plugin"
  if omarchy-shell shell rescanPlugins >/dev/null && omarchy-plugin-enable hark.shell; then
    echo "hark is in the bar (right section); move it with: omarchy bar move hark.shell"
  else
    echo "note: the shell did not take hark's bar widget now; later run: omarchy plugin enable hark.shell" >&2
  fi

  bindings="$config_home/hypr/bindings.lua"
  if [[ ! -f $bindings ]]; then
    echo "note: no $bindings; bind Super Alt D to hark-panel yourself" >&2
  elif ! grep -qxF -- "$bind_mark" "$bindings"; then
    printf '\n%s\n%s\n' "$bind_mark" 'o.bind("SUPER + ALT + D", "Dictation panel", "hark-panel")' >>"$bindings"
    if command -v omarchy-restart-hyprctl >/dev/null 2>&1; then
      omarchy-restart-hyprctl
    fi
  fi
else
  echo "note: no omarchy-shell (Omarchy 4): skipped hark's bar widget and the Super Alt D panel" >&2
fi

echo "hark is Omarchy's dictation backend: hold Right Alt or press Alt+Space; Super Alt D opens its panel."
"$hark" doctor || true
