# systemd user unit for the local CPU ASR server (offline fallback; scripts/cpu-server-up).
# Install with @REPO@ replaced by the absolute path of the skriv checkout (after `uv sync` and
# `scripts/fetch-transcribe` there):
#   sed "s|@REPO@|$PWD|g" packaging/systemd/skriv-cpu-server.service \
#     > ~/.config/systemd/user/skriv-cpu-server.service
#   systemctl --user daemon-reload && systemctl --user enable --now skriv-cpu-server
# It listens on 127.0.0.1:50052; list it last in the client's [[providers]].
[Unit]
Description=skriv local CPU ASR server (transcribe.cpp, offline fallback)

[Service]
ExecStart=@REPO@/scripts/cpu-server-up
Restart=on-failure
RestartSec=5
UMask=0077
# Dictation should not stutter the desktop; one decode at a time anyway.
Nice=5

[Install]
WantedBy=default.target
