# Generated by `skriv service install` (skriv_client/service/linux.py). Customise with a drop-in
# (`systemctl --user edit <unit>`): edits here are lost on reinstall.
[Unit]
Description=llama-server for skriv text cleanup (127.0.0.1:8080)
Before=skriv-server.service

[Service]
Type=exec
ExecStart=/usr/lib/skriv/scripts/llama-up
# ready once the model is loaded (/health answers 503 until then)
ExecStartPost=curl -fsS -o /dev/null --retry 150 --retry-delay 1 --retry-connrefused http://127.0.0.1:8080/health
TimeoutStartSec=3min
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
