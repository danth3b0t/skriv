# Generated by `skriv service install` (skriv_client/service/linux.py). Customise with a drop-in
# (`systemctl --user edit <unit>`): edits here are lost on reinstall.
[Unit]
Description=skriv inference server (ASR + text cleanup proxy)
After=skriv-llama.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/skriv-server --config %E/skriv/server.toml
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=2min
# exit 2 = configuration error, 3 = backend unavailable: a restart cannot fix them
RestartPreventExitStatus=2 3
# the first start may download the ASR model before health says SERVING
TimeoutStartSec=15min
WatchdogSec=30
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
