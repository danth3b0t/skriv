# Generated by `skriv service install` (skriv_client/service/linux.py). Customise with a drop-in
# (`systemctl --user edit <unit>`): edits here are lost on reinstall.
[Unit]
Description=skriv dictation daemon
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
Type=notify
NotifyAccess=main
# Without a display in the user manager's environment skriv could not paste: skip the start
# (not a failure). Import it and start again: see `skriv service install` or docs/linux.md.
ExecCondition=/bin/sh -c 'test -n "$${WAYLAND_DISPLAY}$${DISPLAY}"'
ExecStart=/usr/bin/skriv run
Restart=on-failure
RestartSec=2
# exit 2 = configuration error: a restart cannot fix it
RestartPreventExitStatus=2
WatchdogSec=30
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
