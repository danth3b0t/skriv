#!/usr/bin/env bash
# Run hark-server on the transcribe.cpp backend: the local, offline ASR fallback
# (Parakeet TDT 0.6B v3 GGUF). Fails fast with a hint when something is missing, so it
# can run as a service (packaging/systemd/hark-cpu-server.service).
#
#   scripts/cpu-server-up                          # CPU on 127.0.0.1:50052
#   scripts/cpu-server-up --device metal           # Apple GPU (or vulkan / cuda, if built so)
#   scripts/cpu-server-up --threads 4 --listen 127.0.0.1:50060
#   scripts/cpu-server-up -- --log-level DEBUG     # args after -- go to hark-server
#
# Env: HARK_CPU_MODEL (GGUF path; default models/parakeet-tdt-0.6b-v3-Q4_K_M.gguf).
# Setup once: uv sync && scripts/fetch-transcribe [vulkan|cuda]
# Then point the client at it, last in [[providers]] (see client/README.md).
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
listen=127.0.0.1:50052
device=cpu
threads=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --listen) listen="$2"; shift 2 ;;
    --device) device="$2"; shift 2 ;;
    --threads) threads="$2"; shift 2 ;;
    --) shift; break ;;
    *) echo "cpu-server-up: unknown argument '$1' (--listen, --device, --threads, -- server args)" >&2; exit 2 ;;
  esac
done

model="${HARK_CPU_MODEL:-$root/models/parakeet-tdt-0.6b-v3-Q4_K_M.gguf}"
lib=""
# The CPU backend is in every build; a GPU device needs its own build.
case "$device" in
  cpu) candidates=(cpu metal vulkan cuda) ;;
  *) candidates=("$device") ;;
esac
for v in "${candidates[@]}"; do
  if [[ -e $root/build/transcribe/$v/lib ]]; then
    lib="$root/build/transcribe/$v/lib"
    break
  fi
done
if [[ -z $lib ]]; then
  echo "cpu-server-up: no transcribe.cpp build for device '$device' under build/transcribe;" \
    "run scripts/fetch-transcribe ${device/cpu/}" >&2
  exit 1
fi
if [[ ! -f $model ]]; then
  echo "cpu-server-up: $model missing; run scripts/fetch-transcribe" >&2
  exit 1
fi
server="$root/.venv/bin/hark-server"
if [[ ! -x $server ]]; then
  echo "cpu-server-up: $server missing; run uv sync in $root" >&2
  exit 1
fi

# [backend.options] have no CLI flags: write them to a config file next to the build.
config="$root/build/transcribe/cpu-server.toml"
cat >"$config" <<EOF
# written by scripts/cpu-server-up; edits are overwritten
[server]
listen = "$listen"
accelerator = "transcribe.cpp $device"

[backend]
kind = "transcribe_cpp"
model = "$model"

[backend.options]
device = "$device"
threads = $threads
library = "$lib"
binding = "$root/build/transcribe/python"
EOF
exec "$server" --config "$config" "$@"
