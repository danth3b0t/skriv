#!/usr/bin/env bash
# Download a pinned prebuilt llama.cpp release (llama-server) into ./models/bin ($HARK_MODELS_DIR/bin).
#
#   scripts/fetch-llama            # macOS arm64 (Metal) or linux-x64 CPU
#   scripts/fetch-llama vulkan     # linux-x64 Vulkan
#   scripts/fetch-llama cuda       # linux-x64 CUDA 12.8 (+ the cudart runtime bundle)
#
# Result: models/bin/llama-<tag>-<variant>/ and the symlink models/bin/llama-server.
# sha256 digests are the ones GitHub publishes for the release assets.
set -euo pipefail

TAG=b12284 # 2026-11-11, llama.cpp 0.9.0-dev, commit 9e9619d03
BASE="https://github.com/ggml-org/llama.cpp/releases/download/$TAG"

root="$(cd "$(dirname "$0")/.." && pwd)"
# A checkout keeps models in ./models; an installed copy (hark-git: /usr/lib/hark/scripts) uses the
# XDG data dir. HARK_MODELS_DIR overrides both.
if [[ -f $root/pyproject.toml ]]; then
  models="${HARK_MODELS_DIR:-$root/models}"
else
  models="${HARK_MODELS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/hark/models}"
fi
bin="$models/bin"
os="$(uname -s)-$(uname -m)"
gpu="${1:-}"

case "$os/$gpu" in
  Darwin-arm64/ | Darwin-arm64/metal) variant=macos-arm64 ;;
  Linux-x86_64/ | Linux-x86_64/cpu) variant=ubuntu-x64 ;;
  Linux-x86_64/vulkan) variant=ubuntu-vulkan-x64 ;;
  Linux-x86_64/cuda) variant=ubuntu-cuda-12.8-x64 ;;
  *)
    echo "fetch-llama: unsupported platform/backend '$os/$gpu'" >&2
    echo "  supported: Darwin-arm64 (metal), Linux-x86_64 (cpu | vulkan | cuda)" >&2
    exit 2
    ;;
esac

# asset name -> sha256
assets=("llama-$TAG-bin-$variant.tar.gz")
[[ $variant == ubuntu-cuda-12.8-x64 ]] && assets+=("cudart-llama-$TAG-bin-$variant.tar.gz")

sha_of() {
  case "$1" in
    llama-"$TAG"-bin-macos-arm64.tar.gz) echo 7965e7701df311c49cfc629cfe14cc5092fcc590ef8c85f4c436a2973031e9d0 ;;
    llama-"$TAG"-bin-ubuntu-x64.tar.gz) echo 50b5f85d45f8ddc7179d1b9b65de6534fbb18dc075942413238cb3471570123f ;;
    llama-"$TAG"-bin-ubuntu-vulkan-x64.tar.gz) echo 94bfdf9ad9ab4e5544acc71d8699942fe8013b6c3b39f24570262782619de707 ;;
    llama-"$TAG"-bin-ubuntu-cuda-12.8-x64.tar.gz) echo 8c99a2c600135e7f7d26d82a8b691cf945f2a0c86c9dae6f65a39950566b2236 ;;
    cudart-llama-"$TAG"-bin-ubuntu-cuda-12.8-x64.tar.gz) echo 0c38a225211653ea910dfb6efe69c72f281da1b66ebda8e43b6af14d55528933 ;;
    *) return 1 ;;
  esac
}

sha256() {
  if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}

dest="$bin/llama-$TAG-$variant"
if [[ -x $dest/llama-server ]]; then
  echo "fetch-llama: $dest already present"
else
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/x"
  for asset in "${assets[@]}"; do
    want="$(sha_of "$asset")"
    echo "fetch-llama: downloading $asset"
    curl -fL --retry 3 --progress-bar -o "$tmp/$asset" "$BASE/$asset"
    got="$(sha256 "$tmp/$asset")"
    if [[ $got != "$want" ]]; then
      echo "fetch-llama: sha256 mismatch for $asset: got $got, want $want" >&2
      exit 1
    fi
    tar -xzf "$tmp/$asset" -C "$tmp/x"
  done
  # The archives unpack into llama-<tag>/ (layout of the cudart bundle may differ: flatten).
  mkdir -p "$dest"
  find "$tmp/x" -mindepth 1 -maxdepth 2 \( -type f -o -type l \) -exec mv -f {} "$dest/" \;
  if [[ ! -x $dest/llama-server ]]; then
    echo "fetch-llama: llama-server not found in the archive" >&2
    rm -rf "$dest"
    exit 1
  fi
fi
ln -sfn "llama-$TAG-$variant/llama-server" "$bin/llama-server"
"$bin/llama-server" --version 2>&1 | head -1
echo "fetch-llama: $bin/llama-server -> llama-$TAG-$variant"
