#!/usr/bin/env bash
# Download pinned cleanup GGUFs into ./models (sha256-verified).
#
#   scripts/fetch-models                 # the default cleanup model
#   scripts/fetch-models all             # every model below (eval)
#   scripts/fetch-models qwen3-0.6b-q8_0 qwen3-1.7b-q4_k_m
#
# Q8_0 comes from the official Qwen repos; Qwen does not publish Q4_K_M for
# these sizes, so Q4_K_M comes from unsloth. "S1-mini" by "Superwhisper"
# (a Qwen3-0.6B fine-tune, Apache-2.0 + naming term) comes from
# superwhisper/s1-mini-GGUF; its LICENSE and NOTICE are kept next to it.
# Revisions are pinned commits.
set -euo pipefail

# Default chosen in docs/bench/2026-11-11-cleanup-s1.md (scripts/llama-up reads this line).
DEFAULT=s1-mini-q4_k_m
KEYS=(s1-mini-q4_k_m qwen3-0.6b-q8_0 qwen3-0.6b-q4_k_m qwen3-1.7b-q8_0 qwen3-1.7b-q4_k_m)

# key -> "repo revision file sha256"
spec() {
  case "$1" in
    qwen3-0.6b-q8_0) echo "Qwen/Qwen3-0.6B-GGUF 23749fefcc72300e3a2ad315e1317431b06b590a Qwen3-0.6B-Q8_0.gguf 9465e63a22add5354d9bb4b99e90117043c7124007664907259bd16d043bb031" ;;
    qwen3-1.7b-q8_0) echo "Qwen/Qwen3-1.7B-GGUF 90862c4b9d2787eaed51d12237eafdfe7c5f6077 Qwen3-1.7B-Q8_0.gguf 061b54daade076b5d3362dac252678d17da8c68f07560be70818cace6590cb1a" ;;
    qwen3-0.6b-q4_k_m) echo "unsloth/Qwen3-0.6B-GGUF 50968a4468ef4233ed78cd7c3de230dd1d61a56b Qwen3-0.6B-Q4_K_M.gguf ac2d97712095a558e31573f62f466a3f9d93990898b0ec79d7c974c1780d524a" ;;
    qwen3-1.7b-q4_k_m) echo "unsloth/Qwen3-1.7B-GGUF d7f544eead698dbd1f15126ef60b45a1e1933222 Qwen3-1.7B-Q4_K_M.gguf b139949c5bd74937ad8ed8c8cf3d9ffb1e99c866c823204dc42c0d91fa181897" ;;
    s1-mini-q4_k_m) echo "superwhisper/s1-mini-GGUF 34add00a48a2e5d24e5a4ee5405a99620a3a240c s1-mini-q4_k_m.gguf 3b41ebe2502cbd03e811d5d16b022f5ab551eda58d62597d152f89535003c634" ;;
    *) return 1 ;;
  esac
}

# key -> license files that must be kept with the weights: "file sha256" lines
extras() {
  case "$1" in
    s1-mini-*) printf '%s\n' \
      "LICENSE f715982df6ce767ae64864d74b95644e5d658aab54717dbceeb252eb3cbcb421" \
      "NOTICE 6eb1e98a0d0046dd1b71da19d3b64ebccc12622e7d62e5efcad10298b4d66292" ;;
  esac
}

sha256() {
  if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}

root="$(cd "$(dirname "$0")/.." && pwd)"
models="$root/models"
mkdir -p "$models"

fetch() { # repo rev file sha256 out
  local out="$5" got
  if [[ -f $out ]]; then
    echo "fetch-models: $out already present"
    return
  fi
  echo "fetch-models: downloading $1/$3@${2:0:8}"
  curl -fL --retry 3 --progress-bar -o "$out.part" "https://huggingface.co/$1/resolve/$2/$3"
  got="$(sha256 "$out.part")"
  if [[ $got != "$4" ]]; then
    echo "fetch-models: sha256 mismatch for $3: got $got, want $4" >&2
    rm -f "$out.part"
    exit 1
  fi
  mv "$out.part" "$out"
  echo "fetch-models: $out"
}

keys=("$@")
[[ ${#keys[@]} -eq 0 ]] && keys=("$DEFAULT")
[[ ${keys[0]} == all ]] && keys=("${KEYS[@]}")

for key in "${keys[@]}"; do
  if ! line="$(spec "$key")"; then
    echo "fetch-models: unknown model '$key' (known: ${KEYS[*]})" >&2
    exit 2
  fi
  read -r repo rev file want <<<"$line"
  fetch "$repo" "$rev" "$file" "$want" "$models/$key.gguf"
  while read -r extra extra_sha; do
    [[ -n $extra ]] && fetch "$repo" "$rev" "$extra" "$extra_sha" "$models/$key.$extra"
  done < <(extras "$key")
done
