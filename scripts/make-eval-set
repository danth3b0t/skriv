COMMANDS = {"kubectl", "pnpm", "uv", "ruff", "pytest", "basedpyright", "hyprctl", "journalctl",
            "git", "npm", "pip", "docker", "helm", "k9s", "systemctl", "torchrun", "lefthook"}  # fmt: skip
_PATH_RE = re.compile(r"/|\.(py|ts|tsx|json|md|toml|yaml|yml|conf|tf|prisma|sh)$|^\.")


def kind_of(term: str) -> TermKind:
    if term.startswith("-"):
        return TermKind.FLAG
    if term in COMMANDS or (" " in term and term.split(maxsplit=1)[0] in {"hark", "docker"}):
        return TermKind.COMMAND
    if _PATH_RE.search(term) and not term.startswith("$") and ":" not in term:
        return TermKind.PATH
    if "_" in term or "." in term or re.search(r"[a-z][A-Z]", term):
        return TermKind.IDENTIFIER
    return TermKind.NAME


NEEDED_ORIGINS = [
    (Origin.USER, 2), (Origin.ASSISTANT, 3), (Origin.TOOLS, 2), (Origin.TERMINAL_TEXT, 0),
    (Origin.BUFFER, 0),
]  # fmt: skip
DISTRACTOR_ORIGINS = [
    (Origin.ASSISTANT, 6), (Origin.TOOLS, 6), (Origin.PERSIST_REPO, 0), (Origin.REPO_RECENT, 0),
    (Origin.REPO, 0), (Origin.PERSIST_USER, 0), (Origin.BUFFER, 0),
]  # fmt: skip


def shortlist(
    rng: random.Random, needed: list[str], project: str, n_distractors: int
) -> tuple[list[Candidate], int]:
    """Candidates for rank(): the clip's terms with strong, recent evidence, and distractors
    from the project's vocabulary with the weaker evidence most of a real list has."""
    out: list[Candidate] = []
    for t in needed:
        for _ in range(rng.choice((1, 1, 2))):
            origin, max_age = rng.choice(NEEDED_ORIGINS)
            out.append(
                Candidate(t, kind_of(t), origin, rng.uniform(0.6, 1.0), rng.randint(0, max_age))
            )
    taken = {re.sub(r"[^0-9a-z]", "", t.lower()) for t in needed}
    pool = [t for t in POOLS[project] if re.sub(r"[^0-9a-z]", "", t.lower()) not in taken]
    if project != "hark":  # a few personal terms from earlier sessions in other repos
        pool += rng.sample(HARK_POOL, 6)
    picked = rng.sample(pool, min(n_distractors, len(pool)))
    for t in picked:
        origin, max_age = rng.choice(DISTRACTOR_ORIGINS)
        out.append(Candidate(t, kind_of(t), origin, rng.uniform(0.3, 1.0), rng.randint(0, max_age)))
    return out, len(picked)


APPS = {
    "term": [("Ghostty", "com.mitchellh.ghostty"), ("Ghostty", "com.mitchellh.ghostty"),
             ("Ghostty", "com.mitchellh.ghostty"), ("Alacritty", "Alacritty"), ("kitty", "kitty")],
    "code": [("Code", "code")],
    "slack": [("Slack", "Slack")],
    "notes": [("Obsidian", "obsidian")],
}  # fmt: skip


def context_json(
    rng: random.Random, app: str, project: str, needed: list[str], mode: str
) -> tuple[dict[str, object], str]:
    name, app_id = rng.choice(APPS[app])
    terminal = app == "term"
    pid = rng.randint(1200, 90000)
    cwd, branches = PROJECTS[project]
    if mode == "empty":
        cands: list[Candidate] = []
        n = 0
    else:
        n = rng.randint(15, 28) if mode == "full" else rng.randint(2, 6)
        cands, n = shortlist(rng, needed, project, n)
    ranking = rank(cands, 30)
    lost = [t for t in needed if mode != "empty" and t not in {x.canonical for x in ranking.terms}]
    if lost:
        raise SystemExit(f"shortlist dropped needed terms {lost}")
    snap = ContextSnapshot(
        focus=FocusInfo(app=name, app_id=app_id, title="", pid=pid, is_terminal=terminal,
                        window_id=f"{pid}:{rng.randint(1000, 99999)}"),
        cwd=cwd if terminal else None,
        repo_root=cwd if terminal else None,
        branch=rng.choice(branches) if terminal else None,
        agent=rng.choice(("claude", "pi", "codex")) if terminal else None,
        terms=ranking.terms,
        collected_ms=round(rng.uniform(8, 60), 1),
        provenance=ranking.trace,
        prefetched=True,
    )  # fmt: skip
    # exactly what retry.save keeps of a key-down snapshot
    ctx = snapshot_json(snap)
    for private in ("selection", "agent_last_reply"):
        ctx.pop(private, None)
    focus: dict[str, object] = ctx["focus"]  # pyright: ignore[reportAssignmentType]
    focus["title"] = ""
    desc = f"app {name} ({app_id}); context {mode}: {len(ranking.terms)} terms"
    if mode != "empty":
        desc += f" ({len(needed)} for this clip, {n} distractors from {project})"
    return ctx, desc


# -- speech ---------------------------------------------------------------------------------------


@dataclass(frozen=True)
class Voice:
    engine: str  # kokoro | say
    name: str
    accent: str  # en_US, en_GB, ..., or "L2 es" (non-native English)
    lang: str = "en-us"  # kokoro phonemizer language


V = Voice
VOICE_GROUPS: list[tuple[int, list[Voice]]] = [
    (34, [V("kokoro", v, "en_US") for v in (
        "af_heart", "af_bella", "af_nicole", "af_sarah", "af_sky", "af_kore", "af_aoede",
        "am_adam", "am_michael", "am_eric", "am_liam", "am_onyx", "am_puck", "am_fenrir")]
        + [V("say", "Samantha", "en_US")]),
    (18, [V("kokoro", v, "en_GB", "en-gb") for v in (
        "bf_emma", "bf_isabella", "bf_alice", "bf_lily", "bm_george", "bm_lewis", "bm_daniel",
        "bm_fable")] + [V("say", "Daniel", "en_GB")]),
    (7, [V("say", "Karen", "en_AU")]),
    (7, [V("say", "Moira", "en_IE")]),
    (14, [V("say", v, "en_IN") for v in ("Rishi", "Aman", "Tara")]
        + [V("kokoro", v, "en_IN") for v in ("hf_alpha", "hf_beta", "hm_omega", "hm_psi")]),
    (7, [V("say", "Tessa", "en_ZA")]),
    (9, [V("kokoro", "ef_dora", "L2 es"), V("kokoro", "em_alex", "L2 es"),
         V("kokoro", "ff_siwis", "L2 fr"), V("kokoro", "if_sara", "L2 it"),
         V("kokoro", "im_nicola", "L2 it"), V("kokoro", "pf_dora", "L2 pt"),
         V("kokoro", "pm_alex", "L2 pt")]),
]  # fmt: skip


def voice_slots(n: int, rng: random.Random) -> list[Voice]:
    slots = [vs[i % len(vs)] for count, vs in VOICE_GROUPS for i in range(count)]
    while len(slots) < n:
        slots += slots
    rng.shuffle(slots)
    return slots[:n]


class Tts:
    def __init__(self, model_dir: Path) -> None:
        self.model_dir = model_dir
        self._kokoro: Any = None

    def kokoro(self, text: str, voice: Voice, speed: float) -> np.ndarray:
        if self._kokoro is None:
            from kokoro_onnx import Kokoro  # noqa: PLC0415 - heavy, only when needed

            paths = {n: fetch(u, self.model_dir / n, d) for n, (u, d) in KOKORO.items()}
            self._kokoro = Kokoro(str(paths["kokoro-v1.0.onnx"]), str(paths["voices-v1.0.bin"]))
        samples, rate = self._kokoro.create(text, voice=voice.name, speed=speed, lang=voice.lang)
        return soxr.resample(np.asarray(samples, np.float32), rate, SR).astype(np.float32)

    @staticmethod
    def say(text: str, voice: Voice, rate: int) -> np.ndarray:
        with tempfile.TemporaryDirectory() as d:
            aiff, wav = Path(d) / "s.aiff", Path(d) / "s.wav"
            say = ["say", "-v", voice.name, "-r", str(rate), "-o", str(aiff), text]
            subprocess.run(say, check=True)  # noqa: S603 - macOS tools
            convert = [
                "afconvert",
                "-f",
                "WAVE",
                "-d",
                "LEI16@16000",
                "-c",
                "1",
                str(aiff),
                str(wav),
            ]
            subprocess.run(convert, check=True)  # noqa: S603
            return pcm_to_float(read_wav(wav))


def pcm_to_float(pcm16: bytes) -> np.ndarray:
    return np.frombuffer(pcm16, "<i2").astype(np.float32) / 32768.0


# -- acoustics -------------------------------------------------------------------------------------


def active_rms(x: np.ndarray) -> float:
    """RMS over the 20 ms frames within 35 dB of the loudest one (speech, not pauses)."""
    n = len(x) // 320
    if n == 0:
        return float(np.sqrt(np.mean(x**2)) + 1e-9)
    frames = np.sqrt(np.mean(x[: n * 320].reshape(n, 320) ** 2, axis=1)) + 1e-9
    keep = frames[frames > frames.max() * 10 ** (-35 / 20)]
    return float(np.sqrt(np.mean(keep**2)))


def coloured(n: int, rng: np.random.Generator, exponent: float) -> np.ndarray:
    """Noise with a 1/f**exponent power spectrum (1 = pink, 2 = brown), unit RMS."""
    spec = np.fft.rfft(rng.standard_normal(n))
    f = np.fft.rfftfreq(n, 1 / SR)
    f[0] = f[1]
    x = np.fft.irfft(spec / f ** (exponent / 2), n)
    return (x / (np.sqrt(np.mean(x**2)) + 1e-12)).astype(np.float32)


def shaped(x: np.ndarray, gains: list[tuple[float, float]]) -> np.ndarray:
    """Filter by a piecewise-linear gain curve over frequency [(Hz, dB), ...]."""
    spec = np.fft.rfft(x)
    f = np.fft.rfftfreq(len(x), 1 / SR)
    db = np.interp(f, [g[0] for g in gains], [g[1] for g in gains])
    return np.fft.irfft(spec * 10 ** (db / 20), len(x)).astype(np.float32)


def fan(n: int, rng: np.random.Generator) -> np.ndarray:
    hum_hz = rng.choice([50.0, 60.0])
    t = np.arange(n) / SR
    hum = sum(np.sin(2 * np.pi * hum_hz * k * t + rng.uniform(0, 6)) / k for k in (1, 2, 3, 4))
    air = shaped(coloured(n, rng, 1.0), [(0, -6), (300, 0), (2000, -4), (8000, -18)])
    return (air + 0.15 * hum).astype(np.float32)


def keyboard(n: int, rng: np.random.Generator) -> np.ndarray:
    """Typing: bursts of 2-8 ms clicks, 80-300 ms apart, with pauses between words."""
    out = np.zeros(n, np.float32)
    pos = int(rng.uniform(0, 0.4) * SR)
    while pos < n:
        length = int(rng.uniform(0.002, 0.008) * SR)
        click = rng.standard_normal(length) * np.exp(-np.linspace(0, 6, length))
        click = shaped(np.pad(click, (0, 64)), [(0, -20), (1500, 0), (6000, -3), (8000, -10)])
        end = min(n, pos + len(click))
        out[pos:end] += click[: end - pos] * rng.uniform(0.4, 1.0)
        pos += int(rng.uniform(0.08, 0.3) * SR) + (
            int(rng.uniform(0.3, 1.2) * SR) if rng.random() < 0.12 else 0
        )
    return out / (np.sqrt(np.mean(out**2)) + 1e-12)


def reverb(x: np.ndarray, rng: np.random.Generator, rt60: float) -> np.ndarray:
    """Room: direct path plus an exponentially decaying diffuse tail (synthetic RIR)."""
    n = int(rt60 * SR)
    tail = rng.standard_normal(n) * np.exp(-6.9 * np.arange(n) / n)
    tail = shaped(tail, [(0, -3), (1000, 0), (4000, -6), (8000, -15)])
    rir = np.zeros(n + int(0.004 * SR), np.float32)
    rir[0] = 1.0
    rir[int(0.004 * SR) :] += (
        tail * rng.uniform(0.08, 0.2) / np.sqrt(np.mean(tail**2)) / math.sqrt(n / SR * 100)
    )
    size = 1 << (len(x) + len(rir)).bit_length()
    y = np.fft.irfft(np.fft.rfft(x, size) * np.fft.rfft(rir, size), size)[: len(x) + len(rir)]
    return y.astype(np.float32)


class Noise:
    def __init__(self, cache: Path) -> None:
        self.cache = cache
        self._demand: dict[str, np.ndarray] = {}

    def demand(self, env: str) -> np.ndarray:
        if env not in self._demand:
            wav = self.cache / "demand" / f"{env}_ch01.wav"
            if not wav.is_file():
                url = f"https://zenodo.org/api/records/1227121/files/{env}_16k.zip/content"
                z = fetch(url, self.cache / "demand" / f"{env}_16k.zip", DEMAND[env], "md5")
                with zipfile.ZipFile(z) as zf:
                    member = next(m for m in zf.namelist() if m.endswith("ch01.wav"))
                    wav.write_bytes(zf.read(member))
                z.unlink()
            self._demand[env] = pcm_to_float(read_wav(wav))
        return self._demand[env]

    def segment(self, env: str, n: int, rng: np.random.Generator) -> np.ndarray:
        src = self.demand(env)
        start = int(rng.integers(0, len(src) - n))
        x = src[start : start + n]
        return x / (np.sqrt(np.mean(x**2)) + 1e-12)


CONDITIONS = [  # name, weight, SNR range (dB)
    ("quiet room", 25, None),
    ("office", 13, (8, 22)),
    ("cafeteria", 12, (6, 18)),
    ("living room", 10, (8, 20)),
    ("meeting babble", 6, (10, 20)),
    ("fan", 12, (8, 20)),
    ("keyboard", 14, (12, 24)),
    ("keyboard + office", 8, (10, 20)),
]
DEMAND_ENV = {"office": "OOFFICE", "cafeteria": "PCAFETER", "living room": "DLIVING",
              "meeting babble": "OMEETING", "keyboard + office": "OOFFICE"}  # fmt: skip


def render(speech: np.ndarray, rng: np.random.Generator, noise: Noise) -> tuple[bytes, str]:
    """Speech at a talker level, maybe in a room and through a laptop mic, padded like a
    push-to-talk recording, over room tone and a background condition."""
    level_db = float(rng.uniform(-32, -20))
    x = speech / active_rms(speech) * 10 ** (level_db / 20)
    parts = [f"level {level_db:.0f} dBFS"]
    if rng.random() < 0.4:
        rt60 = float(rng.uniform(0.2, 0.7))
        x = reverb(x, rng, rt60)
        parts.append(f"reverb RT60 {rt60:.2f} s")
    if rng.random() < 0.3:
        x = shaped(x, [(0, -30), (120, -12), (250, 0), (3000, 2), (6000, -2), (8000, -8)])
        parts.append("laptop mic")
    lead, trail = int(rng.uniform(0.15, 0.5) * SR), int(rng.uniform(0.25, 0.8) * SR)
    x = np.concatenate([np.zeros(lead, np.float32), x, np.zeros(trail, np.float32)])
    n = len(x)
    tone_db = float(rng.uniform(-64, -54))
    x = x + coloured(n, rng, 1.0) * 10 ** (tone_db / 20)  # room tone: never digital silence
    names = [c[0] for c in CONDITIONS]
    cond = names[
        int(
            rng.choice(
                len(names), p=np.array([c[1] for c in CONDITIONS]) / sum(c[1] for c in CONDITIONS)
            )
        )
    ]
    snr_range = {c[0]: c[2] for c in CONDITIONS}[cond]
    if snr_range is not None:
        snr = float(rng.uniform(*snr_range))
        if cond == "fan":
            bg = fan(n, rng)
        elif cond == "keyboard":
            bg = keyboard(n, rng)
        elif cond == "keyboard + office":
            bg = 0.7 * keyboard(n, rng) + 0.7 * noise.segment(DEMAND_ENV[cond], n, rng)
        else:
            bg = noise.segment(DEMAND_ENV[cond], n, rng)
        x = x + bg / np.sqrt(np.mean(bg**2)) * 10 ** ((level_db - snr) / 20)
        parts.append(f"{cond} at SNR {snr:.0f} dB")
    else:
        parts.append(f"quiet room (tone {tone_db:.0f} dBFS)")
    peak = float(np.max(np.abs(x)))
    if peak > 0.99:
        x = x * 0.99 / peak
    return to_pcm16(x.astype(np.float32)), ", ".join(parts)


# -- the set on disk ---------------------------------------------------------------------------------


def write_clip(
    out: Path, cid: str, pcm16: bytes, ctx: dict[str, object], label: dict[str, object]
) -> None:
    d = out / cid
    d.mkdir(parents=True, exist_ok=True)
    write_wav(d / "audio.wav", pcm16)
    (d / "context.json").write_text(json.dumps(ctx, ensure_ascii=False, sort_keys=True) + "\n")
    label_path = d / "label.json"
    if label_path.is_file():  # keep reviews of the same speech
        old: dict[str, object] = json.loads(label_path.read_text())
        if old.get("said") == label["said"]:
            label["accepted"] = old.get("accepted", [])
    (label_path).write_text(json.dumps(label, ensure_ascii=False, indent=2) + "\n")


def synth_clips(out: Path, only: set[str], tts: Tts, noise: Noise) -> None:
    rng = random.Random(SEED)
    voices = voice_slots(len(PROMPTS), rng)
    for i, (p, voice) in enumerate(zip(PROMPTS, voices, strict=True), 1):
        cid = f"syn-{i:03d}"
        crng = random.Random(f"{SEED}:{cid}")
        nrng = np.random.default_rng(crng.randrange(2**32))
        if only and cid not in only:
            continue
        text = p.tts or p.said
        if voice.engine == "kokoro":
            speed = round(crng.uniform(0.85, 1.25), 2)
            speech, how = tts.kokoro(text, voice, speed), f"Kokoro-82M {voice.name} speed {speed}"
        else:
            rate = crng.randint(150, 230)
            speech, how = tts.say(text, voice, rate), f"macOS say {voice.name} {rate} wpm"
        pcm16, acoustics = render(speech, nrng, noise)
        ctx, ctx_desc = context_json(crng, p.app, p.project, terms_for(p), p.ctx)
        label = {
            "said": p.said,
            "critical": p.critical,
            "forbidden": p.forbidden,
            "accepted": [],
            "note": f"synthetic ({voice.accent}): {how}; {acoustics}; {ctx_desc}; "
            f"tags {', '.join(p.tags) or '-'}" + (f"; TTS read {p.tts!r}" if p.tts else ""),
        }
        write_clip(out, cid, pcm16, ctx, label)
        print(f"{cid} {voice.accent:<6} {len(pcm16) / 2 / SR:5.1f} s  {p.said[:70]}")


def terms_for(p: Prompt) -> list[str]:
    return list(dict.fromkeys(p.terms))


# -- real speech --------------------------------------------------------------------------------------


@dataclass(frozen=True)
class RealClip:
    source: str
    text: str
    audio: np.ndarray  # 16 kHz float
    meta: str  # provenance for the note


def words(text: str) -> list[str]:
    return re.findall(r"[a-z']+", text.lower())


def traps_in(text: str) -> list[str]:
    """Hark identifiers whose spoken form occurs in ``text``, and sound-alike terms."""
    w = words(text)
    joined = " " + " ".join(w) + " "
    hits = [t for t in TRAPS if any(f" {a} " in joined for a in spoken_forms(t, kind_of(t))[:1])]
    hits += [SOUND_ALIKE[x] for x in dict.fromkeys(w) if x in SOUND_ALIKE]
    return list(dict.fromkeys(hits))


def _negated(text: str) -> bool:
    return any(x in {"not", "no", "never", "nothing"} or x.endswith("n't") for x in words(text))


def pick(cands: list[tuple[int, str, Any]], n: int) -> list[tuple[int, str, Any]]:
    """The ``n`` candidates with the most trap words, then a negation, then dataset order."""

    def key(c: tuple[int, str, Any]) -> tuple[int, int]:
        return (-(3 * len(traps_in(c[1])) + _negated(c[1])), c[0])

    return sorted(cands, key=key)[:n]


def _usable(text: str, seconds: float) -> bool:
    n = len(text.split())
    return 3 <= seconds <= 14 and 8 <= n <= 40 and not re.search(r"[<\[(]|PARTICIPANT", text)


def edacc(cache: Path) -> list[RealClip]:
    import pyarrow.parquet as pq  # noqa: PLC0415
    import soundfile as sf  # noqa: PLC0415
    from huggingface_hub import HfFileSystem  # noqa: PLC0415

    out: list[RealClip] = []
    fs = HfFileSystem()
    for name in EDACC_FILES:
        rows: list[dict[str, Any]] = []
        for rg in EDACC_ROW_GROUPS:
            cached = cache / "edacc" / f"{EDACC_REV[:12]}-{name}-rg{rg}.json"
            if not cached.is_file():
                path = f"datasets/edinburghcstr/edacc@{EDACC_REV}/data/{name}"
                table = pq.ParquetFile(fs.open(path, block_size=1 << 22)).read_row_group(rg)
                keep: list[dict[str, Any]] = []
                for i, r in enumerate(table.to_pylist()):
                    data, rate = sf.read(io.BytesIO(r["audio"]["bytes"]), dtype="float32")
                    if data.ndim > 1:
                        data = data.mean(axis=1)
                    if not _usable(r["text"], len(data) / rate):
                        continue
                    wav = cached.parent / f"{name[:10]}-rg{rg}-{i:03d}.wav"
                    wav.parent.mkdir(parents=True, exist_ok=True)
                    write_wav(wav, to_pcm16(soxr.resample(data, rate, SR).astype(np.float32)))
                    fields = {k: r[k] for k in ("speaker", "text", "accent", "l1", "gender")}
                    keep.append(fields | {"rg": rg, "row": i, "wav": wav.name})
                cached.write_text(json.dumps(keep, indent=1))
            rows += json.loads(cached.read_text())
        cands = [(r["rg"] * 1000 + r["row"], r["text"], r) for r in rows]
        for _, text, r in pick(cands, EDACC_PER_FILE):
            meta = (f"EdACC (edinburghcstr/edacc@{EDACC_REV[:8]}, test {name[:10]} row group "
                    f"{r['rg']} row {r['row']}; speaker {r['speaker']}, {r['accent']}, L1 "
                    f"{r['l1']}, {r['gender']}); license CC-BY-SA-4.0")  # fmt: skip
            audio = pcm_to_float(read_wav(cache / "edacc" / r["wav"]))
            out.append(RealClip("edacc", text, audio, meta))
    return out


def librispeech(cache: Path) -> list[RealClip]:
    import pyarrow.parquet as pq  # noqa: PLC0415
    import soundfile as sf  # noqa: PLC0415

    url, digest = LIBRISPEECH
    rows: list[dict[str, Any]] = pq.read_table(
        fetch(url, cache / "librispeech_asr_dummy.parquet", digest)
    ).to_pylist()
    cands = []
    for r in rows:
        data, rate = sf.read(io.BytesIO(r["audio"]["bytes"]), dtype="float32")
        if _usable(r["text"], len(data) / rate):
            cands.append((len(cands), r["text"], (r, data, rate)))
    out = []
    for _, text, (r, data, rate) in pick(cands, LIBRISPEECH_CLIPS):
        meta = (f"LibriSpeech dev-clean {r['id']} via hf-internal-testing/librispeech_asr_dummy@"
                f"{url.split('/resolve/')[1][:8]} (speaker {r['speaker_id']}, read audiobook); "
                "license CC-BY-4.0")  # fmt: skip
        out.append(
            RealClip("librispeech", text, soxr.resample(data, rate, SR).astype(np.float32), meta)
        )
    return out


def real_clips(out: Path, only: set[str], cache: Path) -> None:
    clips = edacc(cache) + librispeech(cache)
    for i, c in enumerate(clips, 1):
        cid = f"real-{i:03d}"
        if only and cid not in only:
            continue
        rng = random.Random(f"{SEED}:{cid}")
        traps = traps_in(c.text)
        app = "term" if i % 6 else rng.choice(("slack", "notes", "code"))
        ctx, ctx_desc = context_json(rng, app, "hark", traps, "full")
        said = " ".join(c.text.lower().split())
        lead = np.zeros(int(rng.uniform(0.15, 0.4) * SR), np.float32)
        pcm16 = to_pcm16(np.concatenate([lead, c.audio, lead]))
        label = {
            "said": said,
            "critical": [],
            "forbidden": [t for t in traps if t.lower() not in said],
            "accepted": [],
            "note": f"real speech: {c.meta}; {ctx_desc}; trap terms on the list: "
            f"{', '.join(traps) or 'none'}",
        }
        write_clip(out, cid, pcm16, ctx, label)
        print(f"{cid} {len(pcm16) / 2 / SR:5.1f} s traps={traps} {said[:60]}")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--out", default=str(ROOT / "eval" / "dev-v1"))
    ap.add_argument("--cache", default=str(ROOT / "models" / "eval-cache"), help="downloads")
    ap.add_argument("--models", default=str(ROOT / "models" / "kokoro"), help="Kokoro model files")
    ap.add_argument("--only", action="append", default=[], help="a clip id (repeatable)")
    ap.add_argument("--part", choices=["all", "syn", "real"], default="all")
    args = ap.parse_args()
    out, cache = Path(args.out), Path(args.cache)
    only = set(args.only)
    if args.part in ("all", "syn"):
        synth_clips(out, only, Tts(Path(args.models)), Noise(cache))
    if args.part in ("all", "real"):
        real_clips(out, only, cache)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
