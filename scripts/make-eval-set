def fetch(url: str, dest: Path, digest: str, algo: str = "sha256") -> Path:
    if dest.is_file() and hashlib.new(algo, dest.read_bytes()).hexdigest() == digest:
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    print(f"downloading {url}", file=sys.stderr)
    tmp = dest.with_suffix(dest.suffix + ".part")
    with urllib.request.urlopen(url) as r, tmp.open("wb") as f:  # noqa: S310 - pinned https URLs
        shutil.copyfileobj(r, f, 1 << 20)
    got = hashlib.new(algo, tmp.read_bytes()).hexdigest()
    if got != digest:
        tmp.unlink()
        raise SystemExit(f"{url}: {algo} {got}, expected {digest}")
    tmp.rename(dest)
    return dest


